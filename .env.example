# Copy to .env.local and fill in. Never commit .env.local.
# Only NEXT_PUBLIC_* values reach the browser; everything else stays server-side.

# Supabase (local values come from `supabase status`)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The one email allowed to log in
ALLOWED_EMAIL=

# AI: gemini | deepseek | mock
AI_PROVIDER=mock
AI_MODEL=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=

# IANA timezone for "today", day grouping and weeks
APP_TIMEZONE=Asia/Jakarta
